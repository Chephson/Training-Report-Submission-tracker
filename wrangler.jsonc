{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-10-23",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "report-tracker",
          "database_id": "b8e12cd1-56e0-4460-a570-15b58fc4219c"
        }
      ]
    },
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "report-tracker-hcot-preview",
          "database_id": "26b2a079-accf-4d05-bf1c-c1e8ca523e1e"
        }
      ]
    }
  }
}
